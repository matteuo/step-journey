{
  "name": "step-journey",
  "version": "2.0.0",
  "description": "A customizable Angular library for visualizing step-by-step journeys.",
  "author": "matteuo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
