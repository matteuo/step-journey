    "test": "ng test",
    "publish:lib": "npm run build:lib && npm publish ./dist/step-journey"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.7",
    "rxjs": "~7.8.0",
    "typescript": "~5.9.3",
    "zone.js": "~0.15.0"
