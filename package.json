    "test": "ng test",
    "publish:lib": "npm run build:lib && npm publish ./dist/step-journey"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/compiler-cli": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/platform-browser-dynamic": "^20.3.35",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.2",
    "rxjs": "~7.8.0",
    "typescript": "~5.9.3",
    "zone.js": "~0.15.0"
